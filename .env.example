# Copy this file to .env and fill it in LOCALLY. NEVER commit .env (it is gitignored).
# Every value is intentionally empty here; qm/config.py supplies safe defaults.
#
# MODEL_PROVIDER: mock (default, no model needed) | anthropic (hosted; current demo plan) | ollama (local GPU)
MODEL_PROVIDER=
# OLLAMA_HOST default: http://localhost:11434
OLLAMA_HOST=
# OLLAMA_MODEL default: qwen3:8b   (fallback: qwen3:4b)
OLLAMA_MODEL=
# Hosted provider key (MODEL_PROVIDER=anthropic). Never commit .env.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL default: claude-haiku-4-5 (step up: claude-sonnet-5-5)
ANTHROPIC_MODEL=
# DEMO_MODE: live (default) | offline (cache only, never calls a model)
DEMO_MODE=
# RANDOM_SEED default: 42
RANDOM_SEED=
